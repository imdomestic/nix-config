# Who can read which sops file. Rendered into .sops.yaml by `just sops-config`;
# CI fails when the committed file drifts from this. The keys themselves live
# with what they belong to: `hosts.<name>.ageKey` (the machine),
# `hosts.<name>.users.<account>.ageKey` (an account on a machine) and
# `users.<account>.ageKeys` (keys tied to no registry machine).
{
  config,
  lib,
  ...
}: let
  inherit (config) hosts users;

  host = n:
    if hosts.${n}.ageKey != null
    then hosts.${n}.ageKey
    else throw "flake/secrets.nix: hosts.${n} has no ageKey";
  on = account: n: hosts.${n}.users.${account}.ageKey;
  own = account: label: users.${account}.ageKeys.${label};

  # Every key an account has: one per machine it has a key on, plus its own.
  keysOf = account:
    lib.concatMap (h: lib.optional ((h.users.${account}.ageKey or null) != null) h.users.${account}.ageKey)
    (lib.attrValues hosts)
    ++ lib.attrValues users.${account}.ageKeys;
  everyone = lib.concatMap keysOf (lib.attrNames users);

  # Readers of everything not narrowed below.
  admins =
    [(on "hank" "hackintosh") (on "hank" "praxic") (on "hank" "wsl")]
    ++ lib.attrValues users.hank.ageKeys
    ++ [(own "linwhite" "personal") (own "fendada" "personal") (own "kenneth" "personal")];

  # Hosts whose own secrets are administered by someone other than `admins`.
  # They also stay out of the shared files.
  hostAdmins = {
    # linwhite 的机器,hank 不读。
    seraph = [(own "linwhite" "personal") (on "linwhite" "seraph")];
    encore = admins ++ [(on "linwhite" "encore")];
  };
  readersOf = n: (hostAdmins.${n} or admins) ++ [(host n)];

  keyed = lib.attrNames (lib.filterAttrs (_: h: h.ageKey != null) hosts);
  gaojiControl = config.placements.gaoji-control.host;

  rule = path_regex: age: {inherit path_regex age;};
  rules =
    [
      (rule "secrets/hosts/encore-vex-github-(private-key|client-secret)$" (readersOf "encore"))
      (rule "secrets/hosts/encore-acme\\.env$" (readersOf "encore"))
      (rule "secrets/hosts/h610-(max|ops)\\.yaml$" (readersOf "h610"))
      (rule "secrets/hosts/tank-max\\.yaml$" (readersOf "tank"))
      # 网关的 API key:用它的人,加上网关自己。
      (rule "secrets/clients/bonsai\\.yaml$" (readersOf config.placements.bonsai-ninfer.host))
      # 每个人都用 cliproxy;系统里读它的是 h610 的 gaoji profile 和 tank 的 max。
      (rule "secrets/clients/cliproxy\\.yaml$" (everyone ++ map host ["h610" "tank"]))
      # tank 集群的 cluster-admin token,只给 hank 自己的机器(home/modules/kube)。
      (rule "secrets/clients/kube-tank\\.yaml$" (keysOf "hank"))
      (rule "secrets/gaoji/(account-auth|control)\\.yaml$" (admins ++ [(host gaojiControl)]))
    ]
    ++ map (w: rule "secrets/gaoji/worker-${lib.escapeRegex w}\\.yaml$" (admins ++ lib.unique (map host [gaojiControl w])))
    (lib.attrNames (import ../lib/gaoji-workers.nix))
    ++ map (n: rule "secrets/hosts/${lib.escapeRegex n}\\.yaml$" (readersOf n)) keyed
    ++ [
      # Shared secrets: every admin and every host they administer.
      (rule "secrets/.*\\.yaml$" (admins ++ map host (lib.filter (n: !(hostAdmins ? ${n})) keyed)))
    ];

  # Label every key in the rendered file so a diff says whose access changed.
  labels =
    lib.mapAttrs' (n: h: lib.nameValuePair h.ageKey "host ${n}") (lib.filterAttrs (_: h: h.ageKey != null) hosts)
    // lib.listToAttrs (lib.concatLists (lib.mapAttrsToList (n: h:
      lib.mapAttrsToList (a: acct: lib.nameValuePair acct.ageKey "${a}@${n}")
      (lib.filterAttrs (_: acct: acct.ageKey != null) h.users))
    hosts))
    // lib.listToAttrs (lib.concatLists (lib.mapAttrsToList (a: u:
      lib.mapAttrsToList (label: key: lib.nameValuePair key "${a} (${label})") u.ageKeys)
    users));

  render = r:
    "  - path_regex: '${r.path_regex}'\n"
    + "    key_groups:\n"
    + "      - age:\n"
    + lib.concatMapStrings (k: "          - ${k} # ${labels.${k}}\n") (lib.unique r.age);
in {
  flake.sopsConfig =
    ''
      # Generated by `just sops-config` from flake/secrets.nix and the registry's
      # ageKey fields; CI fails if this file drifts. Edit those, not this.
      #
      # Account keys: ~/.ssh/id_ed25519 through ssh-to-age, private half in
      # ~/.config/sops/age/keys.txt. Host keys: ssh-keyscan -t ed25519 <host> | ssh-to-age.
      creation_rules:
    ''
    + lib.concatMapStrings render rules;
}
