+void test_full_catalog_preserves_other_owners_when_search_expires() {
+    for (const std::size_t physical_pressure : {0U, 3U}) {
+        constexpr std::uint32_t owner_count = 8;
+        FakeManager manager = make_manager(1, owner_count);
+        FakeProgram program;
+        for (std::uint32_t index = 0; index < owner_count; ++index) {
+            const std::uint32_t content = 100U + index;
+            const auto active = start_active(manager, program, content, make_base(content), index + 1U);
+            (void)finish_active(manager, program, active);
+        }
+
+        program.required_pressure_actions = physical_pressure;
+        program.private_pressure_alternatives = 4;
+        program.pressure_action_immediate_ns = 1;
+        // One exact assessment consumes the optional search budget. A complete seed must
+        // satisfy catalog admission as well as physical capacity before search can expire.
+        program.pressure_assessment_delay_us = 6'000;
+        const auto incoming = start_active(manager, program, 200, make_base(200), 20);
+        RuntimeStats stats;
+        manager.populate_runtime_stats(program, stats);
+        require(stats.pressure_private_owners_evicted == 1,
+                "full catalog admission discarded more than one parked owner");
+        (void)finish_active(manager, program, incoming);
+
+        program.required_pressure_actions = 0;
+        program.pressure_assessment_delay_us = 0;
+        std::uint32_t surviving_hits = 0;
+        for (std::uint32_t index = 0; index < owner_count; ++index) {
+            const std::uint32_t content = 100U + index;
+            const auto reuse = manager.inspect(program, FakePreparedPrompt{content},
+                                               make_base(content), 30U + index);
+            require(reuse.choice.has_value(), "survivor lookup did not produce a plan");
+            surviving_hits += reuse.choice->summary().reusable_prompt_tokens == 16 ? 1U : 0U;
+        }
+        require(surviving_hits == owner_count - 1,
+                "unrelated checkpoints stopped being reusable after catalog pressure");
+    }
+}
+
+void test_full_catalog_reuses_source_slot_without_eviction() {
+    constexpr std::uint32_t owner_count = 8;
+    FakeManager manager = make_manager(1, owner_count);
+    FakeProgram program;
+    std::uint32_t source_id = 0;
+    for (std::uint32_t index = 0; index < owner_count; ++index) {
+        const std::uint32_t content = 100U + index;
+        const auto active = start_active(manager, program, content, make_base(content), index + 1U);
+        source_id = active.sequence.id;
+        (void)finish_active(manager, program, active);
+    }
+    program.required_pressure_actions = 3;
+    program.private_pressure_alternatives = 4;
+    program.pressure_action_immediate_ns = 1;
+    program.pressure_assessment_delay_us = 6'000;
+    const auto resumed = start_active(manager, program, 107, make_base(107), 20);
+    RuntimeStats stats;
+    manager.populate_runtime_stats(program, stats);
+    require(stats.pressure_private_owners_evicted == 0,
+            "resuming a private owner needlessly evicted another owner for its slot");
+    require(program.started_source_id == source_id &&
+                program.started_source_mode == PrivateSourceMode::ConsumeToActive,
+            "full catalog prevented reuse of the consumed source checkpoint");
+    (void)finish_active(manager, program, resumed);
+}
