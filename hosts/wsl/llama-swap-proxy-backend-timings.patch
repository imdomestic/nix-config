+func TestPrefillTrackingReadCloser_PublishesBackendTimings(t *testing.T) {
+	tracker := NewPrefillProgressTracker(time.Minute, time.Minute, false)
+	defer tracker.Close()
+
+	type timingEvent struct {
+		sessionID string
+		messageID string
+		timings   map[string]interface{}
+	}
+	received := make(chan timingEvent, 1)
+	tracker.SetTimingNotifyFunc(func(sessionID, messageID string, timings map[string]interface{}) {
+		received <- timingEvent{sessionID: sessionID, messageID: messageID, timings: timings}
+	})
+
+	key := prefillProgressKey{SessionID: "timing-s", MessageID: "timing-m"}
+	payload := "data: {\"choices\":[],\"timings\":{\"predicted_n\":42,\"predicted_ms\":350,\"predicted_per_second\":117.1}}\n\n"
+	rc := newPrefillTrackingReadCloser(nopCloseReader{Reader: bytes.NewReader([]byte(payload))}, tracker, key)
+	_, _ = io.Copy(io.Discard, rc)
+	_ = rc.Close()
+
+	select {
+	case event := <-received:
+		if event.sessionID != key.SessionID || event.messageID != key.MessageID {
+			t.Fatalf("unexpected correlation: %+v", event)
+		}
+		if got, ok := event.timings["predicted_per_second"].(float64); !ok || got != 117.1 {
+			t.Fatalf("unexpected timings: %+v", event.timings)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("timing callback was not invoked")
+	}
+}
