+// SetTimingNotifyFunc registers a callback for backend timing objects found in
+// streamed responses. The payload is forwarded unchanged so consumers can use
+// the backend's own counters and rates instead of estimating them from text.
+func (t *PrefillProgressTracker) SetTimingNotifyFunc(fn func(sessionID, messageID string, timings map[string]interface{})) {
+	t.notifyMu.Lock()
+	t.timingFn = fn
+	t.notifyMu.Unlock()
+}
+
+func (t *PrefillProgressTracker) PublishTimings(key prefillProgressKey, timings map[string]interface{}) {
+	if key.SessionID == "" || key.MessageID == "" || len(timings) == 0 {
+		return
+	}
+	t.notifyMu.RLock()
+	fn := t.timingFn
+	t.notifyMu.RUnlock()
+	if fn != nil {
+		fn(key.SessionID, key.MessageID, timings)
+	}
+}
