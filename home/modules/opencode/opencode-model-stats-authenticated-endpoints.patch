diff --git a/src/prefill-endpoints.ts b/src/prefill-endpoints.ts
new file mode 100644
--- /dev/null
+++ b/src/prefill-endpoints.ts
@@ -0,0 +1,35 @@
+import { readFileSync } from "node:fs"
+
+export function readPrefillEndpoints(value: unknown): Map<string, Record<string, string>> {
+  const endpoints = new Map<string, Record<string, string>>()
+  if (value === undefined) return endpoints
+  if (!Array.isArray(value)) throw new TypeError("prefillWsEndpoints must be an array")
+  for (const endpoint of value) {
+    if (!endpoint || typeof endpoint.url !== "string" || typeof endpoint.apiKeyFile !== "string") {
+      throw new TypeError("Each prefill endpoint requires url and apiKeyFile")
+    }
+    const url = new URL(endpoint.url)
+    if (!["ws:", "wss:"].includes(url.protocol) || url.username || url.password) {
+      throw new Error("Invalid prefill WebSocket URL")
+    }
+    const key = readFileSync(endpoint.apiKeyFile, "utf8").trim()
+    if (!key) throw new Error(`Empty prefill API key file: ${endpoint.apiKeyFile}`)
+    if (endpoints.has(url.href)) throw new Error(`Duplicate prefill endpoint: ${url.href}`)
+    endpoints.set(url.href, { Authorization: `Bearer ${key}` })
+  }
+  return endpoints
+}
+
+export function connectPrefillSocket(url: string, endpoints: Map<string, Record<string, string>>): WebSocket {
+  const headers = endpoints.get(url)
+  if (!headers) return new WebSocket(url)
+  // OpenCode 使用 Bun 的 WebSocket，自定义请求头通过运行时扩展提供。
+  const AuthenticatedWebSocket = WebSocket as typeof WebSocket & {
+    new(url: string, options: { headers: Record<string, string> }): WebSocket
+  }
+  return new AuthenticatedWebSocket(url, { headers })
+}
+
+export function isConfiguredPrefillEndpoint(url: string, endpoints: Map<string, Record<string, string>>): boolean {
+  return endpoints.has(url)
+}
